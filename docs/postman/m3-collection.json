          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{resident_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"emergency_type\": \"medical\", \"description\": \"Chest tightness\"}" },
            "url": "{{base_url}}/api/incidents/sos/"
          }
        },
        {
          "name": "03. List Filtered & Paginated Incidents (Admin)",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "pm.test('Paginated shape', () => { pm.expect(j).to.have.property('count'); pm.expect(j.results).to.be.an('array'); });"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/incidents/?status=REPORTED&category=fire&search=Newman&page=1&page_size=10"
          }
        },
        {
          "name": "04. Get Incident Detail (Reporter)",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "pm.test('Has reporter, evidence, history_summary', () => {",
                "  pm.expect(j.reporter).to.have.property('name');",
                "  pm.expect(j.evidence_urls.length).to.be.at.least(1);",
                "  pm.expect(j.history_summary.total_events).to.be.at.least(1);",
                "});"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{resident_token}}" }],
            "url": "{{base_url}}/api/incidents/{{incident_id}}/"
          }
        },
        {
          "name": "05. Upload Additional Evidence Photo",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
