    {
      "name": "Incidents success",
      "item": [
        {
          "name": "01. Report Detailed Incident (Form + Evidence Image)",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Created 201', () => pm.response.to.have.status(201));",
                "const j = pm.response.json();",
                "pm.test('Status REPORTED', () => pm.expect(j.status).to.eql('REPORTED'));",
                "pm.test('Has location & evidence', () => { pm.expect(j.location_available).to.be.true; pm.expect(j.evidence_count).to.eql(1); });",
                "pm.environment.set('incident_id', j.id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{resident_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Newman Fire Smoke Test", "type": "text" },
                { "key": "category", "value": "fire", "type": "text" },
                { "key": "description", "value": "Smoke reported near meter room", "type": "text" },
                { "key": "latitude", "value": "12.971600", "type": "text" },
                { "key": "longitude", "value": "77.594600", "type": "text" },
                { "key": "images", "type": "file", "src": "docs/postman/sample_evidence.png" }
              ]
            },
            "url": "{{base_url}}/api/incidents/"
          }
        },
        {
          "name": "02. Trigger One-Tap SOS",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
